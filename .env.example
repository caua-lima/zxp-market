# Inventário das variáveis do ZXP Market — VALORES FALSOS, só pra mostrar o formato.
# Copie pra .env.local (local) ou cadastre na Vercel (Settings → Environment Variables).
# A conferência roda na subida do servidor: lib/config/ambiente.ts.
# Nunca coloque valor de verdade neste arquivo — ele é versionado e o repositório é público.

# ── Firebase Admin (servidor) — do JSON da conta de serviço ─────────────────
FIREBASE_PROJECT_ID=meu-projeto-exemplo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-exemplo@meu-projeto-exemplo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHAVE-FALSA\n-----END PRIVATE KEY-----\n"

# ── Firebase no navegador — Console → Configurações do projeto → Seus apps ─
NEXT_PUBLIC_FIREBASE_API_KEY=chave-publica-falsa
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=meu-projeto-exemplo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=meu-projeto-exemplo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=meu-projeto-exemplo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Push (Cloud Messaging → Certificados push da Web). Sem ela, push fica desligado.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=chave-vapid-falsa

# ── Mercado Livre — painel de Developers do ML ─────────────────────────────
ML_APP_ID=0000000000000000
ML_SECRET=segredo-falso
ML_REDIRECT_URI=https://seu-app.vercel.app/api/ml/callback
# Só no modo raiz (operação de uma empresa). No modo empresa o vendedor vem da conexão.
ML_SELLER_ID=

# ── Rotinas (cron da Vercel e worker do GitHub Actions) ───────────────────
# 32+ caracteres aleatórios. O MESMO valor vai no segredo CRON_SECRET do GitHub.
CRON_SECRET=troque-por-32-caracteres-aleatorios

# ── Primeiro acesso (só modo raiz) ────────────────────────────────────────
BOOTSTRAP_OWNER_EMAILS=dono@exemplo.com

# ── Multi-empresa (docs/saas/OPERACAO.md) — vazio = modo raiz, como sempre foi ─
NEXT_PUBLIC_ZXP_MODO_DADOS=
NEXT_PUBLIC_ZXP_TENANT_ID=

# ── Tela "O que mudou" (opcional) ─────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=

# ── Cobrança (S25, docs/saas/OPERACAO.md parte E) — vazio = desligada ─────
# Chaves de TESTE do Stripe (Developers → API keys, com "Test mode" ligado).
STRIPE_SECRET_KEY=
# Developers → Webhooks → o endpoint /api/billing/webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Products → cada plano → o ID do preço (price_…). O valor mora no Stripe.
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
# Endereço público do app (volta do checkout/portal). Ex.: https://seu-app.vercel.app
APP_URL=
# Só com chave de PRODUÇÃO (sk_live_), e só quando decidir cobrar de verdade.
ZXP_COBRANCA_LIVE=

# ── Cadastro self-service de empresa (S24) — "1" liga; as DUAS iguais ─────
ZXP_CADASTRO_ABERTO=
NEXT_PUBLIC_ZXP_CADASTRO_ABERTO=

# ── Só desenvolvimento/testes: NUNCA na Vercel ───────────────────────────
# NEXT_PUBLIC_FIREBASE_EMULADOR=127.0.0.1:8199,127.0.0.1:9299
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8199
