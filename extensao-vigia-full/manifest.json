{
  "manifest_version": 3,
  "name": "ZXP — Vigia da agenda do Full",
  "version": "2.7.0",
  "description": "Vigia da agenda do Full, leitura da Gestão de envios Full e margem de cada promoção na página de promoções do ML — com o seu login do Mercado Livre neste Chrome e os custos do Dash.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://vendedores.mercadolivre.com.br/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vigia da agenda do Full",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icone.png"
    }
  },
  "icons": {
    "128": "icone.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vendedores.mercadolivre.com.br/anuncios/lista/promos*",
        "https://www.mercadolivre.com.br/anuncios/lista/promos*"
      ],
      "js": [
        "promocoes.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "margem-promocao.js"
      ],
      "matches": [
        "https://vendedores.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*"
      ]
    }
  ]
}
