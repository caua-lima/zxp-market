{
  "manifest_version": 3,
  "name": "ZXP — Vigia da agenda do Full",
  "version": "1.6.0",
  "description": "Confere a página de agendamento dos envios pro Full (com o seu login do Mercado Livre neste Chrome) e avisa quando abrir data.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://vendedores.mercadolivre.com.br/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vigia da agenda do Full",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icone.png"
    }
  },
  "icons": {
    "128": "icone.png"
  }
}
