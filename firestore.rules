rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function requesterDoc() {
      return get(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email));
    }

    // Só o owner pode escrever. Admin foi removido — qualquer outro papel é leitura.
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email))
        && requesterDoc().data.role == "owner";
    }

    function isAuthorized() {
      return signedIn()
        && exists(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email));
    }

    /**
     * "member" — o papel que só acompanha o resultado.
     *
     * Vê o Dashboard e recebe notificações, e NADA que revele o núcleo do
     * negócio: custo do produto, margem, preço, estoque, DRE, tarefas.
     * Esconder as abas no app não bastaria — sem barrar aqui, qualquer um
     * leria as coleções direto pelo SDK do cliente.
     *
     * Papéis legados ("colaborador"/"admin"/"user") NÃO são member: eles já
     * viam tudo, e a migração não pode tirar acesso de quem trabalha. Só o
     * valor explícito "member" restringe (espelha papelDe em
     * lib/domain/types.ts).
     */
    function isMember() {
      return isAuthorized() && requesterDoc().data.get('role', '') == 'member';
    }

    /** Autorizado e NÃO member — quem pode ver os dados da operação. */
    function veOperacao() {
      return isAuthorized() && !isMember();
    }

    // Owner edita tudo, sempre. Colaborador só edita a `tab` se o próprio
    // dono liberou em permissoesEdicao — sem o campo (ou vazio), continua
    // somente-leitura, igual ao comportamento de sempre. Espelha exatamente
    // o canEditTab() de components/tabs/AccessGuard.tsx: aqui é o que
    // realmente barra a escrita, lá é só a UX de esconder o botão.
    function podeEditar(tab) {
      return isOwner()
        // veOperacao (e nao isAuthorized): uma conta rebaixada pra member pode
        // ter permissoesEdicao sobrando de quando era colaborador, e sem isto
        // ela continuaria ESCREVENDO na aba liberada. O papel manda sobre a lista.
        || (veOperacao() && tab in requesterDoc().data.get('permissoesEdicao', []));
    }

    // Autorizado (owner OU colaborador) mexendo só no próprio `photoURL` — é
    // o que permite a foto de perfil funcionar pra colaborador também, sem
    // abrir a porta pra ele mudar o próprio `role` ou qualquer outro campo.
    function isSelfPhotoUpdate(email) {
      return isAuthorized()
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() < 900000;
    }

    // Mesma ideia, pra "Meu Perfil": autorizado troca o PRÓPRIO nome de
    // exibição, sem poder tocar em role/permissoesEdicao/e-mail. Campo
    // separado do de foto (em vez de juntar tudo num "isSelfProfileUpdate")
    // pra manter cada allow o mais restrito possível — o front nunca manda
    // os dois de uma vez mesmo, então não custa nada não juntar.
    function isSelfNameUpdate(email) {
      return isAuthorized()
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() < 120;
    }

    /**
     * O primeiro owner NAO nasce mais aqui.
     *
     * A regra era: qualquer autenticado podia criar controleAcessoMeta/config
     * com o proprio e-mail, desde que esse documento ainda nao existisse.
     * Junto com a regra de controleAcesso logo abaixo, abrir o app logado
     * com qualquer conta Google bastava pra virar dono do painel — a unica
     * trava era chegar primeiro.
     *
     * Agora quem cria e POST /api/acesso/bootstrap, pelo Admin SDK, contra a
     * lista em BOOTSTRAP_OWNER_EMAILS e numa transacao unica. O Admin SDK
     * passa por cima destas regras, entao fechar aqui nao tira nada dele.
     */
    match /controleAcessoMeta/{docId} {
      allow read: if signedIn();
      allow create: if false;
      allow update, delete: if isOwner();
    }

    match /controleAcesso/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow list: if isOwner();
      // Sem o ramo de bootstrap: criar o primeiro owner e da rota
      // /api/acesso/bootstrap, pelo Admin SDK. Aqui so o owner convida.
      allow create: if isOwner();
      allow update: if isOwner()
        || (signedIn() && request.auth.token.email == email && resource.data.role == "owner")
        || isSelfPhotoUpdate(email)
        || isSelfNameUpdate(email);
      allow delete: if isOwner() || (signedIn() && request.auth.token.email == email && resource.data.role == "owner");
    }

    // Coleções do time: leitura por autorizados, escrita só do owner.
    match /rascunho/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    match /dias/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    // Configurações internas: leitura por autorizados (o dashboard lê),
    // escrita somente por admin/owner.
    match /metas/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('metas');
    }

    match /metasHistorico/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('metas');
    }

    /**
     * SEG-07: as escritas passam a ter FORMATO, não só permissão.
     *
     * As três regras abaixo checavam apenas quem podia escrever. Qualquer
     * pessoa com permissão de estoque conseguia gravar `quantidade: "abc"`,
     * `custoUnit: -500` ou um movimento sem produto — e a regra aceitava.
     *
     * O estrago não fica onde nasce. Um NaN numa quantidade contamina toda
     * soma daí pra frente: o total do estoque vira NaN, o CMV vira NaN, e a
     * DRE mostra um campo vazio em vez de um número errado — o que é pior,
     * porque não parece um erro, parece falta de dado.
     *
     * Não é só defesa contra abuso: um bug no cliente, ou um script futuro,
     * grava lixo com a MESMA permissão legítima. A regra é o último ponto
     * onde dá pra recusar.
     */
    /**
     * Data aceitável numa escrita.
     *
     * Aceita as DUAS formas de propósito. `normalizeCostDate` (lib/domain/calc)
     * converte dd/mm/aaaa, o que prova que existem documentos legados nesse
     * formato — e uma regra que só aceitasse ISO recusaria a edição deles.
     *
     * O objetivo aqui é barrar LIXO ("ontem", "", "abc"), não barrar histórico.
     * Recusar uma escrita legítima em produção é pior do que aceitar um
     * formato antigo que a camada de leitura já sabe normalizar.
     */
    /**
     * Mês 01-12 e dia 01-31 — não só "dois dígitos quaisquer". `^[0-9]{4}-
     * [0-9]{2}-[0-9]{2}$` aceitava "2026-99-99": qualquer par de dígitos
     * passava, então o campo protegia contra "abc" mas não contra lixo com a
     * FORMA certa e o VALOR errado (achado S21 da auditoria SaaS). Não
     * valida o limite de dia por mês (fevereiro com 30, abril com 31) — isso
     * exigiria checar o mês pra decidir o teto do dia, o que uma regex sem
     * grupos condicionais não faz; barrar mês/dia fora da faixa 1-12/1-31 já
     * fecha o caso relatado sem inventar um parser de calendário aqui.
     */
    function dataAceitavel(v) {
      return v is string && (
        v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        || v.matches('^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$')
      );
    }

    /**
     * Valor monetário em texto, nas duas convenções.
     *
     * `parseBRNumber` existe justamente porque há valores gravados no formato
     * brasileiro ("1.234,56"). Exigir só ponto decimal bloquearia a edição
     * desses registros.
     *
     * `^[0-9.,]+$` aceitava QUALQUER combinação de dígito/ponto/vírgula —
     * "...", ",,,", "1.2.3.4,5,6" passavam pela regra e só quebravam na
     * LEITURA, onde `parseBRNumber` silenciosamente vira 0 (uma venda ou
     * custo que a tela mostra como zero, sem erro nenhum). Agora exige pelo
     * menos um dígito antes de qualquer separador, cada ponto seguido de
     * dígito (não "1..2" nem ponto solto) e NO MÁXIMO uma vírgula, com até 2
     * casas depois dela — a mesma forma que `parseBRNumber` sabe interpretar.
     */
    function valorAceitavel(v) {
      return v is string && v.size() > 0 && v.matches('^[0-9]+(\\.[0-9]+)*(,[0-9]{1,2})?$');
    }

    /** Número finito e não negativo. Dinheiro e quantidade nunca são negativos por digitação. */
    function numeroNaoNegativo(v) {
      return v is number && v >= 0;
    }

    function custoValido(d) {
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
        // Impede "muitos reais" virar NaN na soma, sem exigir uma convenção
        // só — ver valorAceitavel.
        && valorAceitavel(d.valor)
        && d.freq in ['diario', 'mensal', 'avulso']
        && dataAceitavel(d.data)
        && (!('escopo' in d) || d.escopo in ['dash', 'dre'])
        && (!('ativo' in d) || d.ativo is bool)
        && (!('vigenteDe' in d) || dataAceitavel(d.vigenteDe))
        && (!('vigenteAte' in d) || d.vigenteAte == null || dataAceitavel(d.vigenteAte));
    }

    function produtoValido(d) {
      // `name` opcional de propósito: um produto legado sem o campo não pode
      // ficar impossível de atualizar por causa da regra.
      return (!('name' in d) || (d.name is string && d.name.size() <= 300))
        && (!('custo' in d) || d.custo is string)
        && (!('custoMedio' in d) || numeroNaoNegativo(d.custoMedio))
        && (!('qtdLocal' in d) || d.qtdLocal is number)
        && (!('ativo' in d) || d.ativo is bool);
    }

    function movimentoValido(d) {
      return d.productId is string && d.productId.size() > 0
        && d.tipo in ['entrada', 'saldo_inicial', 'saida_full', 'ajuste']
        // Ajuste é o ÚNICO que aceita sinal: ele existe pra corrigir pra
        // baixa. Nos outros, negativo é erro de digitação e inverteria o
        // sentido do lançamento em silêncio.
        && d.quantidade is number
        && (d.tipo == 'ajuste' || d.quantidade >= 0)
        && (!('custoUnit' in d) || numeroNaoNegativo(d.custoUnit))
        && (!('estoqueAntes' in d) || numeroNaoNegativo(d.estoqueAntes))
        && dataAceitavel(d.data)
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 500));
    }

    match /custos/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('custos') && custoValido(request.resource.data);
      allow delete: if podeEditar('custos');
    }

    match /estoque/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('estoque') && produtoValido(request.resource.data);
      allow delete: if podeEditar('estoque');
    }

    // Livro de movimentações do estoque (entradas/baixas/ajustes)
    match /estoque_movimentos/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('estoque') && movimentoValido(request.resource.data);
      allow delete: if podeEditar('estoque');
    }

    // Registro manual de alterações de campanha de Ads ("subi o ROAS pra
    // 20x") — não vem do ML, é o vendedor documentando a própria mudança.
    match /ads_alteracoes/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('ads');
    }

    // Remessas do Full marcadas como resolvidas (sem gerar baixa)
    match /full_remessas/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    // Tarefas (Kanban): owner e colaborador leem E escrevem igual — é o
    // ponto do quadro, um atribui tarefa pro outro e vice-versa.
    match /tarefas/{docId} {
      // Member não participa da operação — não lê nem escreve tarefa.
      allow read, write: if veOperacao();
    }

    // Registro de push: um doc por (pessoa, instalação), id = "email__deviceId".
    //
    // O navegador só LÊ o próprio registro (o diagnóstico precisa saber se ele
    // existe) e pode apagá-lo. Criar e alterar é só do servidor, pela rota
    // /api/push/vincular: as invariantes (um token pertence a uma pessoa, teto
    // de instalações) precisam apagar documentos de OUTRA conta quando o
    // aparelho troca de dono, e nenhuma regra por documento deixaria o
    // navegador fazer isso. Admin SDK ignora estas regras.
    match /pushTokens/{token} {
      allow read: if isAuthorized() && resource.data.email == request.auth.token.email;
      allow create, update: if false;
      allow delete: if isAuthorized() && resource.data.email == request.auth.token.email;
    }

    // Central de Atenção: um doc por (usuário, chave do alerta) — cada um só
    // mexe nos próprios alertas dispensados, igual ao padrão de pushTokens.
    match /alertasDispensados/{docId} {
      allow read: if isAuthorized() && resource.data.email == request.auth.token.email;
      allow create, update: if isAuthorized() && request.resource.data.email == request.auth.token.email;
      allow delete: if isAuthorized() && resource.data.email == request.auth.token.email;
    }

    // Central de notificações (Fase 7): venda/cancelamento/devolução/alerta,
    // um doc por evento, id = dedupeKey (garante idempotência — ver
    // lib/notification-events.ts). Criação/entrega são só backend via Admin
    // SDK, que ignora estas regras; o cliente só pode marcar como lido ou
    // dispensado, mexendo em readBy/dismissedBy. NÃO valida qual e-mail
    // específico foi escrito dentro do mapa (like isSelfPhotoUpdate faz pro
    // campo inteiro) — é informação de leitura, não crítica o suficiente pra
    // justificar a regra mais complexa; o que importa é travar os campos de
    // negócio (valor, margem, título) contra edição pelo cliente.
    /**
     * O evento COMPLETO — com grossAmount, estimatedProfit e estimatedMargin,
     * e com o dinheiro escrito no titulo e no corpo.
     *
     * A leitura era `isAuthorized()`, ou seja, o `member` lia tudo: o papel
     * que existe pra acompanhar o resultado SEM ver custo e margem recebia
     * lucro e margem de toda venda, pela Central e pelo SDK. Regra do
     * Firestore e por documento, entao esconder tres campos nao era possivel —
     * o evento passou a ser gravado tambem em notification_events_publico, sem
     * dinheiro, e e de la que o member le.
     */
    match /notification_events/{eventId} {
      allow read: if veOperacao();
      allow create, delete: if false;
      // Cada um so marca o PROPRIO lido/dispensado. Antes bastava mexer nos
      // dois mapas, e qualquer autorizado podia gravar (ou apagar) a marca de
      // leitura de outra pessoa.
      allow update: if isAuthorized()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'dismissedBy'])
        && request.resource.data.get('readBy', {}).diff(resource.data.get('readBy', {}))
             .affectedKeys().hasOnly([request.auth.token.email])
        && request.resource.data.get('dismissedBy', {}).diff(resource.data.get('dismissedBy', {}))
             .affectedKeys().hasOnly([request.auth.token.email]);
    }

    /**
     * O espelho redigido: mesmo evento, sem nenhum campo de dinheiro e com
     * titulo/corpo reescritos (ver lib/domain/notificacao-publico).
     *
     * So o Admin SDK grava. A marca de lido/dispensado segue a mesma regra do
     * original: cada um so mexe na propria.
     */
    match /notification_events_publico/{eventId} {
      allow read: if isAuthorized();
      allow create, delete: if false;
      allow update: if isAuthorized()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy", "dismissedBy"])
        && request.resource.data.get("readBy", {}).diff(resource.data.get("readBy", {}))
             .affectedKeys().hasOnly([request.auth.token.email])
        && request.resource.data.get("dismissedBy", {}).diff(resource.data.get("dismissedBy", {}))
             .affectedKeys().hasOnly([request.auth.token.email]);
    }

    /**
     * O outbox de push e o estado de entrega de cada aparelho: NINGUEM alcanca
     * pelo cliente.
     *
     * `notification_outbox` guarda o payload COMPLETO do aviso — com lucro e
     * margem —, e `notification_entregas` diz quem recebeu o que e em que
     * aparelho. Nenhum dos dois serve a tela: o app le a Central pelas colecoes
     * de eventos. So o Admin SDK (o worker de lib/notification-outbox.ts) entra,
     * e ele ignora estas regras; o `false` explicito e pra uma regra ampla
     * adicionada depois nao abrir estas colecoes sem querer.
     */
    match /notification_outbox/{pushId} {
      allow read, write: if false;
    }
    match /notification_entregas/{entregaId} {
      allow read, write: if false;
    }

    /**
     * O feed de avisos DIRECIONADOS de UMA pessoa: notification_feed/{email}/itens/{id}.
     *
     * Tarefa atribuida, lembrete de prazo e teste sao de quem os recebe. Antes
     * caiam na colecao compartilhada e o time todo lia "Nova tarefa atribuida a
     * voce" de outra pessoa — e nenhuma regra por documento consegue esconder
     * isso, porque a decisao era um filtro no React. Aqui o CAMINHO decide: so o
     * dono do e-mail le, e a Central de outra pessoa nunca alcanca este feed.
     *
     * Cada pessoa tem o proprio documento, entao o "lido" e so dela (`lidoEm`), e
     * a unica escrita do cliente e marcar lido/dispensado. Criar e apagar e do
     * servidor (Admin SDK).
     */
    match /notification_feed/{email}/itens/{eventId} {
      allow read: if isAuthorized() && request.auth.token.email == email;
      allow create, delete: if false;
      allow update: if isAuthorized() && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidoEm', 'dispensadoEm']);
    }

    /**
     * O formato das preferências de notificação.
     *
     * O servidor lê este documento na hora de decidir quem recebe o quê (e se o
     * push mostra dinheiro na tela de bloqueio). A escrita era livre: um campo
     * com o tipo errado — `quietHoursDays: null`, `highValueThreshold: "x"` —
     * ia pro banco e só era descoberto na hora de enviar. Aqui o documento só é
     * aceito se cada campo tem o tipo e o intervalo que o servidor espera; o
     * servidor valida DE NOVO ao ler (lib/domain/notification-preferences), que
     * é quem protege contra um documento gravado por outro caminho.
     *
     * Campo desconhecido é recusado: `hasOnly` é o que impede um campo novo de
     * entrar sem alguém decidir o que ele significa.
     */
    function prefsDeNotificacaoValidas(d) {
      return d.keys().hasOnly([
          'toggles', 'quietHoursStart', 'quietHoursEnd', 'quietHoursEnabled', 'quietHoursDays',
          'quietHoursTimezone', 'quietHoursCriticalBypass', 'highValueThreshold', 'groupFastSales',
          'showFinancialValuesInPush', 'onlyCritical'
        ])
        && d.get('toggles', {}) is map
        && d.get('toggles', {}).keys().hasOnly([
          'sale_paid', 'sale_high_value', 'sale_low_margin', 'sale_negative_margin', 'sale_cancelled',
          'return_opened', 'return_completed', 'sales_summary', 'sync_warning', 'task_assigned',
          'stock_low', 'milestone'
        ])
        && d.get('toggles', {}).get('sale_paid', true) is bool
        && d.get('toggles', {}).get('sale_high_value', true) is bool
        && d.get('toggles', {}).get('sale_low_margin', true) is bool
        && d.get('toggles', {}).get('sale_negative_margin', true) is bool
        && d.get('toggles', {}).get('sale_cancelled', true) is bool
        && d.get('toggles', {}).get('return_opened', true) is bool
        && d.get('toggles', {}).get('return_completed', true) is bool
        && d.get('toggles', {}).get('sales_summary', true) is bool
        && d.get('toggles', {}).get('sync_warning', true) is bool
        && d.get('toggles', {}).get('task_assigned', true) is bool
        && d.get('toggles', {}).get('stock_low', true) is bool
        && d.get('toggles', {}).get('milestone', true) is bool
        && d.get('quietHoursEnabled', false) is bool
        && d.get('quietHoursCriticalBypass', true) is bool
        && d.get('groupFastSales', true) is bool
        && d.get('showFinancialValuesInPush', true) is bool
        && d.get('onlyCritical', false) is bool
        && d.get('quietHoursStart', '00:00') is string
        && d.get('quietHoursStart', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.get('quietHoursEnd', '00:00') is string
        && d.get('quietHoursEnd', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.get('quietHoursDays', []) is list
        && d.get('quietHoursDays', []).size() <= 7
        && d.get('quietHoursDays', []).hasOnly([0, 1, 2, 3, 4, 5, 6])
        && d.get('quietHoursTimezone', 'America/Sao_Paulo') is string
        && d.get('quietHoursTimezone', 'America/Sao_Paulo').size() <= 64
        && d.get('highValueThreshold', 0) is number
        && d.get('highValueThreshold', 0) >= 0
        && d.get('highValueThreshold', 0) <= 1000000000;
    }

    // Preferências de notificação por usuário — cada um só lê/escreve as
    // próprias (mais restrito que o /usuarios/{uid}/** legado abaixo, que
    // permite leitura por qualquer autorizado; aqui nem owner lê a do
    // colaborador, e vice-versa). O documento de notificações só é aceito no
    // formato que o servidor espera (ver prefsDeNotificacaoValidas).
    match /usuarios/{uid}/preferences/{docId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (docId != 'notifications' || prefsDeNotificacaoValidas(request.resource.data));
    }

    /**
     * A janela de vendas rapidas e os limites de taxa das rotas de notificacao:
     * NINGUEM alcanca pelo cliente. Sao contadores do servidor (ver
     * lib/notification-janelas e app/api/notify/task-assigned); o `false`
     * explicito impede uma regra ampla, adicionada depois, de abri-los.
     */
    match /notification_janelas/{janelaId} {
      allow read, write: if false;
    }
    match /notification_limites/{limiteId} {
      allow read, write: if false;
    }

    /**
     * `em` tinha que ser só `is number`: um cliente podia gravar QUALQUER
     * timestamp — datar um evento pro passado (escondê-lo de quem só olha
     * "hoje") ou pro futuro. `request.time` é o relógio do SERVIDOR no
     * instante da escrita, e nenhum cliente controla isso. Tolerância de 5
     * min cobre relógio de aparelho dessincronizado sem abrir a porta pra
     * forjar a data.
     *
     * O que isto NÃO resolve — residual anotado em docs/saas/PROGRESSO.md
     * (S20): quem/quando fica preso à verdade do servidor, mas QUAL ação
     * aconteceu (`acao`/`entidade`/`detalhe`) e SE ela foi de fato logada
     * continuam vindo do cliente sem verificação cruzada — a maioria das
     * escritas deste app vai direto do cliente pro Firestore, sem um
     * checkpoint no servidor que pudesse gerar o log sozinho. Resolver isso
     * de vez pede Cloud Functions (gatilho `onWrite`) ou mover as escritas
     * pra rotas de servidor — as duas são mudanças de arquitetura, não uma
     * regra.
     */
    function auditEventValido(d) {
      return d.em is number
        && d.em > request.time.toMillis() - 300000
        && d.em < request.time.toMillis() + 300000;
    }

    // Trilha de auditoria: qualquer autorizado registra a PRÓPRIA ação
    // (não pode assinar em nome de outro), só o owner lê/lista (atividade de
    // colaborador é informação sensível), e ninguém — nem o owner — pode
    // alterar ou apagar um evento já gravado. Log de verdade é imutável.
    match /auditLog/{docId} {
      allow read, list: if isOwner();
      allow create: if isAuthorized()
        && request.resource.data.por == request.auth.token.email
        && auditEventValido(request.resource.data);
      allow update, delete: if false;
    }

    /**
     * Cada um só alcança o PRÓPRIO subdocumento.
     *
     * Esta regra era `read: if isAuthorized()`, herdada de quando havia dados
     * antigos aqui. Como as regras do Firestore são avaliadas em OR, ela
     * vencia a regra estrita de `usuarios/{uid}/preferences` logo acima e
     * qualquer usuário autorizado lia as preferências de notificação de
     * qualquer outro — o oposto do que o código afirma em lib/firebase/data.ts
     * ("cada um só lê/escreve a própria").
     *
     * Hoje o app só grava `usuarios/{uid}/preferences/notifications`, e o
     * único chamador passa `user.uid` (components/NotificationSettings.tsx),
     * então fechar não tira acesso de ninguém.
     */
    /**
     * Transacoes OAuth do Mercado Livre: NINGUEM alcanca pelo cliente.
     *
     * Cada documento guarda o `state` e o `verifier` do PKCE de um vinculo em
     * andamento. Quem lesse um destes conseguiria completar o fluxo no lugar do
     * dono e apontar o painel pra outra loja.
     *
     * So o Admin SDK escreve e le aqui (app/api/ml/auth e app/api/ml/callback),
     * e o Admin SDK passa por cima destas regras. O Firestore ja negaria por
     * falta de regra; isto e explicito pra a intencao ficar escrita e pra uma
     * regra ampla adicionada depois nao abrir a colecao sem querer.
     */
    match /ml_oauth_transacoes/{state} {
      allow read, write: if false;
    }

    /**
     * O resto de usuarios/{uid}, SEM as preferencias.
     *
     * Esta regra era `usuarios/{uid}/{document=**}` e cobria tambem
     * `preferences`. As regras do Firestore se somam (OR): ela liberava a escrita
     * de `preferences/notifications` em QUALQUER formato e anulava a validacao
     * de prefsDeNotificacaoValidas — a regra estrita existia no papel e nao
     * valia. Agora o subdocumento de preferencias so passa pela regra dele.
     */
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usuarios/{uid}/{sub}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && sub != 'preferences';
    }

    /**
     * ─── FUNDAÇÃO MULTI-TENANT (S01 da auditoria SaaS) ──────────────────
     *
     * Aditivo de propósito: nada abaixo é lido ou escrito pelo app hoje —
     * `controleAcesso` e as coleções globais (`estoque`, `custos`, `metas`...)
     * continuam sendo a única fonte de verdade até a migração acontecer (ver
     * docs/saas/MIGRACAO.md, ainda não escrito). Isto só existe pra provar,
     * ANTES de qualquer rota depender disso, que o isolamento entre tenants
     * funciona de verdade — testado contra o emulador, não por leitura.
     *
     * A identidade continua sendo o e-mail do token (mesma escolha de
     * `controleAcesso`, e pelo mesmo motivo: convidar alguém por e-mail
     * precisa funcionar ANTES da pessoa ter um `uid` — ela só ganha uid no
     * primeiro login). `memberships/{email}` é o ponteiro reverso
     * (e-mail → tenant); só o servidor (Admin SDK, que ignora estas regras)
     * o lê, então fica trancado pro cliente — mesmo padrão de
     * `ml_oauth_transacoes` logo acima.
     */
    function membroDoTenant(tenantId, email) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(email));
    }
    function ehMembroDoTenant(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.token.email));
    }
    function ehOwnerDoTenant(tenantId) {
      return ehMembroDoTenant(tenantId) && membroDoTenant(tenantId, request.auth.token.email).data.role == "owner";
    }

    match /tenants/{tenantId} {
      allow read: if ehMembroDoTenant(tenantId);
      // Criação do tenant e mudança de nome/plano passam pelo servidor
      // (Admin SDK) — nenhum cliente cria ou edita o tenant em si.
      allow write: if false;

      match /members/{email} {
        // Cada membro lê o PRÓPRIO registro (pra saber o próprio papel); o
        // owner lê todo mundo (pra administrar o time).
        allow read: if ehMembroDoTenant(tenantId) && (request.auth.token.email == email || ehOwnerDoTenant(tenantId));
        // Convite/remoção passam pelo servidor: o primeiro membro (owner) de
        // um tenant novo não pode se auto-nomear pelo cliente, mesma lição
        // do bootstrap de controleAcesso (app/api/acesso/bootstrap).
        allow write: if false;
      }

      /**
       * Conexão ML por tenant (S03) — guarda token de acesso/refresh do
       * OAuth do Mercado Livre. Igual a `ml_oauth_transacoes` hoje: ninguém
       * lê ou escreve pelo cliente, nunca, nem o próprio owner do tenant —
       * um token de acesso na mão do navegador é um token que qualquer
       * extensão ou script injetado na página rouba. Só o Admin SDK (que
       * ignora estas regras) toca aqui, sempre por uma rota de servidor.
       */
      match /connections/{connectionId} {
        allow read, write: if false;
      }
    }

    match /memberships/{email} {
      allow read, write: if false;
    }
  }
}
