rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function requesterDoc() {
      return get(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email));
    }

    // Só o owner pode escrever. Admin foi removido — qualquer outro papel é leitura.
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email))
        && requesterDoc().data.role == "owner";
    }

    function isAuthorized() {
      return signedIn()
        && exists(/databases/$(database)/documents/controleAcesso/$(request.auth.token.email));
    }

    /**
     * "member" — o papel que só acompanha o resultado.
     *
     * Vê o Dashboard e recebe notificações, e NADA que revele o núcleo do
     * negócio: custo do produto, margem, preço, estoque, DRE, tarefas.
     * Esconder as abas no app não bastaria — sem barrar aqui, qualquer um
     * leria as coleções direto pelo SDK do cliente.
     *
     * Papéis legados ("colaborador"/"admin"/"user") NÃO são member: eles já
     * viam tudo, e a migração não pode tirar acesso de quem trabalha. Só o
     * valor explícito "member" restringe (espelha papelDe em
     * lib/domain/types.ts).
     */
    function isMember() {
      return isAuthorized() && requesterDoc().data.get('role', '') == 'member';
    }

    /** Autorizado e NÃO member — quem pode ver os dados da operação. */
    function veOperacao() {
      return isAuthorized() && !isMember();
    }

    // Owner edita tudo, sempre. Colaborador só edita a `tab` se o próprio
    // dono liberou em permissoesEdicao — sem o campo (ou vazio), continua
    // somente-leitura, igual ao comportamento de sempre. Espelha exatamente
    // o canEditTab() de components/tabs/AccessGuard.tsx: aqui é o que
    // realmente barra a escrita, lá é só a UX de esconder o botão.
    function podeEditar(tab) {
      return isOwner()
        // veOperacao (e nao isAuthorized): uma conta rebaixada pra member pode
        // ter permissoesEdicao sobrando de quando era colaborador, e sem isto
        // ela continuaria ESCREVENDO na aba liberada. O papel manda sobre a lista.
        || (veOperacao() && tab in requesterDoc().data.get('permissoesEdicao', []));
    }

    // Autorizado (owner OU colaborador) mexendo só no próprio `photoURL` — é
    // o que permite a foto de perfil funcionar pra colaborador também, sem
    // abrir a porta pra ele mudar o próprio `role` ou qualquer outro campo.
    function isSelfPhotoUpdate(email) {
      return isAuthorized()
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() < 900000;
    }

    // Mesma ideia, pra "Meu Perfil": autorizado troca o PRÓPRIO nome de
    // exibição, sem poder tocar em role/permissoesEdicao/e-mail. Campo
    // separado do de foto (em vez de juntar tudo num "isSelfProfileUpdate")
    // pra manter cada allow o mais restrito possível — o front nunca manda
    // os dois de uma vez mesmo, então não custa nada não juntar.
    function isSelfNameUpdate(email) {
      return isAuthorized()
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() < 120;
    }

    match /controleAcessoMeta/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && docId == "config"
        && !exists(/databases/$(database)/documents/controleAcessoMeta/config)
        && request.resource.data.ownerEmail == request.auth.token.email;
      allow update, delete: if isOwner();
    }

    match /controleAcesso/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow list: if isOwner();
      allow create: if signedIn() && (
        (!exists(/databases/$(database)/documents/controleAcessoMeta/config)
          && request.auth.token.email == email
          && request.resource.data.role == "owner")
        || isOwner()
      );
      allow update: if isOwner()
        || (signedIn() && request.auth.token.email == email && resource.data.role == "owner")
        || isSelfPhotoUpdate(email)
        || isSelfNameUpdate(email);
      allow delete: if isOwner() || (signedIn() && request.auth.token.email == email && resource.data.role == "owner");
    }

    // Coleções do time: leitura por autorizados, escrita só do owner.
    match /rascunho/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    match /dias/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    // Configurações internas: leitura por autorizados (o dashboard lê),
    // escrita somente por admin/owner.
    match /metas/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('metas');
    }

    match /metasHistorico/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('metas');
    }

    match /custos/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('custos');
    }

    match /estoque/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('estoque');
    }

    // Livro de movimentações do estoque (entradas/baixas/ajustes)
    match /estoque_movimentos/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('estoque');
    }

    // Registro manual de alterações de campanha de Ads ("subi o ROAS pra
    // 20x") — não vem do ML, é o vendedor documentando a própria mudança.
    match /ads_alteracoes/{docId} {
      allow read: if veOperacao();
      allow write: if podeEditar('ads');
    }

    // Remessas do Full marcadas como resolvidas (sem gerar baixa)
    match /full_remessas/{docId} {
      allow read: if veOperacao();
      allow write: if isOwner();
    }

    // Tarefas (Kanban): owner e colaborador leem E escrevem igual — é o
    // ponto do quadro, um atribui tarefa pro outro e vice-versa.
    match /tarefas/{docId} {
      // Member não participa da operação — não lê nem escreve tarefa.
      allow read, write: if veOperacao();
    }

    // Tokens de notificação push (um doc por dispositivo, id = o próprio
    // token). Cada usuário só mexe no que é dele — o servidor lê a lista
    // inteira pra mandar aviso de venda, mas isso é via Admin SDK, que
    // ignora estas regras (não precisa de allow list aqui pra isso).
    match /pushTokens/{token} {
      allow read: if isAuthorized() && resource.data.email == request.auth.token.email;
      allow create, update: if isAuthorized() && request.resource.data.email == request.auth.token.email;
      allow delete: if isAuthorized() && resource.data.email == request.auth.token.email;
    }

    // Central de Atenção: um doc por (usuário, chave do alerta) — cada um só
    // mexe nos próprios alertas dispensados, igual ao padrão de pushTokens.
    match /alertasDispensados/{docId} {
      allow read: if isAuthorized() && resource.data.email == request.auth.token.email;
      allow create, update: if isAuthorized() && request.resource.data.email == request.auth.token.email;
      allow delete: if isAuthorized() && resource.data.email == request.auth.token.email;
    }

    // Central de notificações (Fase 7): venda/cancelamento/devolução/alerta,
    // um doc por evento, id = dedupeKey (garante idempotência — ver
    // lib/notification-events.ts). Criação/entrega são só backend via Admin
    // SDK, que ignora estas regras; o cliente só pode marcar como lido ou
    // dispensado, mexendo em readBy/dismissedBy. NÃO valida qual e-mail
    // específico foi escrito dentro do mapa (like isSelfPhotoUpdate faz pro
    // campo inteiro) — é informação de leitura, não crítica o suficiente pra
    // justificar a regra mais complexa; o que importa é travar os campos de
    // negócio (valor, margem, título) contra edição pelo cliente.
    match /notification_events/{eventId} {
      allow read: if isAuthorized();
      allow create, delete: if false;
      allow update: if isAuthorized()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'dismissedBy']);
    }

    // Preferências de notificação por usuário — cada um só lê/escreve as
    // próprias (mais restrito que o /usuarios/{uid}/** legado abaixo, que
    // permite leitura por qualquer autorizado; aqui nem owner lê a do
    // colaborador, e vice-versa).
    match /usuarios/{uid}/preferences/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Trilha de auditoria: qualquer autorizado registra a PRÓPRIA ação
    // (não pode assinar em nome de outro), só o owner lê/lista (atividade de
    // colaborador é informação sensível), e ninguém — nem o owner — pode
    // alterar ou apagar um evento já gravado. Log de verdade é imutável.
    match /auditLog/{docId} {
      allow read, list: if isOwner();
      allow create: if isAuthorized() && request.resource.data.por == request.auth.token.email;
      allow update, delete: if false;
    }

    /**
     * Cada um só alcança o PRÓPRIO subdocumento.
     *
     * Esta regra era `read: if isAuthorized()`, herdada de quando havia dados
     * antigos aqui. Como as regras do Firestore são avaliadas em OR, ela
     * vencia a regra estrita de `usuarios/{uid}/preferences` logo acima e
     * qualquer usuário autorizado lia as preferências de notificação de
     * qualquer outro — o oposto do que o código afirma em lib/firebase/data.ts
     * ("cada um só lê/escreve a própria").
     *
     * Hoje o app só grava `usuarios/{uid}/preferences/notifications`, e o
     * único chamador passa `user.uid` (components/NotificationSettings.tsx),
     * então fechar não tira acesso de ninguém.
     */
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
